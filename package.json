{
  "name": "vinfer",
  "version": "0.1.4",
  "description": "Extract input/output types from Valibot schemas",
  "keywords": [
    "schema",
    "type-extraction",
    "typescript",
    "valibot",
    "valibot-to-ts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/toiroakr/vinfer.git"
  },
  "bin": {
    "vinfer": "./bin/vinfer"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsgo --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "generate:type-tests": "node ./dist/cli.js 'tests/fixtures/*.ts' --outDir tests/__file_snapshots__ --outPattern '[name].ts' --generate-tests --suffix Schema"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "glob": "^13.0.0",
    "jiti": "^2.6.1",
    "pathe": "^2.0.3",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.0",
    "@types/node": "25.9.5",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "knip": "6.25.0",
    "lefthook": "2.1.10",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "typescript": "7.0.2",
    "valibot": "1.4.2",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0",
    "valibot": ">=1.1.0"
  },
  "packageManager": "pnpm@11.10.0"
}
